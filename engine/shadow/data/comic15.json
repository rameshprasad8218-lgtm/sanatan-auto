{
 "duration": 16.813083333333335,
 "lines": [
  {
   "i": 0,
   "text": "छोटे हनुमान को लगी भूख, और सामने दिखा, इतना बड़ा आम!",
   "start": 0.35,
   "end": 4.533
  },
  {
   "i": 1,
   "text": "पर वो आम नहीं, सूरज था!",
   "start": 4.833,
   "end": 6.689
  },
  {
   "i": 2,
   "text": "गप्प! और सारी दुनिया में, अंधेरा!",
   "start": 6.989,
   "end": 9.281
  },
  {
   "i": 3,
   "text": "इंद्र ने वज्र मारा, ठन! और हनुमान की ठुड्डी सूज गई!",
   "start": 9.581,
   "end": 13.409
  },
  {
   "i": 4,
   "text": "इसीलिए नाम पड़ा, हनुमान!",
   "start": 13.709,
   "end": 15.613
  }
 ]
}